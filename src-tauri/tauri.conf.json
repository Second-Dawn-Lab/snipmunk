{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snipmunk",
  "version": "../package.json",
  "identifier": "lab.seconddawn.snipmunk",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Snipmunk",
        "width": 1040,
        "height": 700,
        "minWidth": 640,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Second Dawn",
    "copyright": "Second Dawn contributors",
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": { "icons/snpr.ico": "snpr.ico" },
    "createUpdaterArtifacts": false,
    "shortDescription": "Snipmunk: a screenshot clipboard",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./installer/hooks.nsh",
        "languages": [
          "English",
          "German",
          "Spanish",
          "French",
          "Italian",
          "Dutch",
          "Polish",
          "Turkish",
          "SimpChinese",
          "TradChinese",
          "Arabic"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_UPDATER_PUBLIC_KEY (see docs/releasing.md, section 2)",
      "endpoints": [
        "https://github.com/Second-Dawn-Lab/snipmunk/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
