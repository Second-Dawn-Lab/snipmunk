<?xml version="1.0" encoding="utf-8"?>
<!-- The Microsoft Store package of Snipmunk (see docs/store.md). scripts\build-msix.ps1 fills in the values in braces:
     the identity from Partner Center (msix\identity.json) and the version from package.json. -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap2="http://schemas.microsoft.com/appx/manifest/uap/windows10/2"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap2 uap3 uap5 uap10 rescap">

  <Identity Name="{IDENTITY_NAME}" Publisher="{PUBLISHER}" Version="{VERSION}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Snipmunk</DisplayName>
    <PublisherDisplayName>{PUBLISHER_DISPLAY_NAME}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Windows 10 version 2004: windows can be left out of screen captures, and the start-up task takes parameters. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="de-de" />
    <Resource Language="es-es" />
    <Resource Language="fr-fr" />
    <Resource Language="it-it" />
    <Resource Language="nl-nl" />
    <Resource Language="pl-pl" />
    <Resource Language="tr-tr" />
    <Resource Language="zh-cn" />
    <Resource Language="zh-tw" />
    <Resource Language="ar-sa" />
    <Resource Language="ur-pk" />
  </Resources>

  <Applications>
    <Application Id="Snipmunk" Executable="snipmunk.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Snipmunk"
        Description="Screenshots, screen recordings and step-by-step guides"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile ShortName="Snipmunk" Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\SmallTile.png" Square310x310Logo="Assets\LargeTile.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- "Start with Windows": off until the user switches it on in Snipmunk (or in Windows' own list). -->
        <uap5:Extension Category="windows.startupTask" Executable="snipmunk.exe" EntryPoint="Windows.FullTrustApplication"
          uap10:Parameters="--hidden">
          <uap5:StartupTask TaskId="SnipmunkStartup" Enabled="false" DisplayName="Snipmunk" />
        </uap5:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="snipmunk-recording">
            <uap:DisplayName>Snipmunk recording project</uap:DisplayName>
            <uap:Logo>Assets\file-snpr.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.snpr</uap:FileType>
            </uap:SupportedFileTypes>
            <uap2:SupportedVerbs>
              <uap3:Verb Id="open" Parameters="&quot;%1&quot;">Open with Snipmunk</uap3:Verb>
            </uap2:SupportedVerbs>
          </uap3:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="snipmunk-guide">
            <uap:DisplayName>Snipmunk guide</uap:DisplayName>
            <uap:Logo>Assets\file-snpd.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.snpd</uap:FileType>
            </uap:SupportedFileTypes>
            <uap2:SupportedVerbs>
              <uap3:Verb Id="open" Parameters="&quot;%1&quot;">Open with Snipmunk</uap3:Verb>
            </uap2:SupportedVerbs>
          </uap3:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="snipmunk-template">
            <uap:DisplayName>Snipmunk template</uap:DisplayName>
            <uap:Logo>Assets\file-snpt.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.snpt</uap:FileType>
            </uap:SupportedFileTypes>
            <uap2:SupportedVerbs>
              <uap3:Verb Id="open" Parameters="&quot;%1&quot;">Open with Snipmunk</uap3:Verb>
            </uap2:SupportedVerbs>
          </uap3:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="microphone" />
    <DeviceCapability Name="webcam" />
  </Capabilities>
</Package>
